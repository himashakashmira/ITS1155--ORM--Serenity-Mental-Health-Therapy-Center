<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="PaymentReport"
              pageWidth="842" pageHeight="595"
              orientation="Landscape"
              columnWidth="782"
              leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              uuid="c3d4e5f6-a7b8-9012-cdef-123456789012">

    <parameter name="REPORT_TITLE"   class="java.lang.String"/>
    <parameter name="GENERATED_DATE" class="java.lang.String"/>
    <parameter name="TOTAL_PAID"     class="java.lang.Double"/>

    <field name="paymentId"   class="java.lang.String"/>
    <field name="sessionId"   class="java.lang.Integer"/>
    <field name="patientName" class="java.lang.String"/>
    <field name="programName" class="java.lang.String"/>
    <field name="amount"      class="java.lang.Double"/>
    <field name="date"        class="java.time.LocalDate"/>
    <field name="status"      class="java.lang.String"/>

    <variable name="TOTAL_AMOUNT" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>

    <title>
        <band height="80" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="80" backcolor="#2D3748" forecolor="#2D3748"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="12" width="500" height="30" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font size="20" isBold="true"/></textElement>
                <text><![CDATA[🌿 Serenity Mental Health Therapy Center]]></text>
            </staticText>
            <textField>
                <reportElement x="20" y="44" width="500" height="22" forecolor="#A0AEC0"/>
                <textElement><font size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="580" y="12" width="182" height="20" forecolor="#A0AEC0"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + $P{GENERATED_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="580" y="34" width="182" height="20" forecolor="#68D391"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total Paid: LKR " + String.format("%.2f", $P{TOTAL_PAID})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="30" backcolor="#276749" forecolor="#276749"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10"  y="7" width="110" height="16" forecolor="#FFFFFF"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Payment ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="125" y="7" width="50"  height="16" forecolor="#FFFFFF"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Sess #]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="7" width="160" height="16" forecolor="#FFFFFF"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Patient]]></text>
            </staticText>
            <staticText>
                <reportElement x="345" y="7" width="190" height="16" forecolor="#FFFFFF"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Program]]></text>
            </staticText>
            <staticText>
                <reportElement x="540" y="7" width="90"  height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Amount (LKR)]]></text>
            </staticText>
            <staticText>
                <reportElement x="635" y="7" width="80"  height="16" forecolor="#FFFFFF"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="720" y="7" width="55"  height="16" forecolor="#FFFFFF"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Status]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="24" backcolor="#F0FFF4" forecolor="#F0FFF4">
                    <printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement x="10"  y="4" width="110" height="16"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{paymentId}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="125" y="4" width="50"  height="16"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{sessionId}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="180" y="4" width="160" height="16"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{patientName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="345" y="4" width="190" height="16"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{programName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="540" y="4" width="90"  height="16"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $F{amount})]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="635" y="4" width="80"  height="16"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$F{date} != null ? $F{date}.toString() : ""]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="720" y="4" width="55"  height="16"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="23" width="782" height="1" forecolor="#C6F6D5"/>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="25">
            <line>
                <reportElement x="0" y="0" width="782" height="1" forecolor="#CBD5E0"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="400" height="16" forecolor="#718096"/>
                <textElement><font size="9"/></textElement>
                <text><![CDATA[Serenity Mental Health Therapy Center – Financial Report – Confidential]]></text>
            </staticText>
            <textField>
                <reportElement x="600" y="5" width="182" height="16" forecolor="#718096"/>
                <textElement textAlignment="Right"><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="40">
            <rectangle>
                <reportElement x="0" y="0" width="782" height="40" backcolor="#E6FFFA" forecolor="#E6FFFA"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="345" y="10" width="190" height="20" forecolor="#276749"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Grand Total (LKR):]]></text>
            </staticText>
            <textField>
                <reportElement x="540" y="10" width="90"  height="20" forecolor="#276749"/>
                <textElement textAlignment="Right"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[String.format("%.2f", $V{TOTAL_AMOUNT})]]></textFieldExpression>
            </textField>
        </band>
    </summary>


</jasperReport>
