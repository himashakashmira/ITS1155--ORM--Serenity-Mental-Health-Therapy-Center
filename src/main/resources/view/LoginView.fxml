<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="520.0" prefWidth="850.0" styleClass="main-bg" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.ijse.serenity.controller.LoginController">

    <Pane layoutX="600" layoutY="-80" prefWidth="360" prefHeight="360"
          style="-fx-background-color:rgba(56,161,105,0.10);-fx-background-radius:360;-fx-effect:dropshadow(gaussian,rgba(56,161,105,0.12),80,0,0,0);"/>
    <Pane layoutX="-80" layoutY="300" prefWidth="300" prefHeight="300"
          style="-fx-background-color:rgba(108,99,255,0.08);-fx-background-radius:300;-fx-effect:dropshadow(gaussian,rgba(108,99,255,0.10),60,0,0,0);"/>

    <children>
        <!-- Center Login Card -->
        <VBox alignment="CENTER" layoutX="225.0" layoutY="50.0"
              prefWidth="400.0" spacing="0.0" styleClass="login-card"
              style="-fx-padding: 35 45;">
            <children>

                <!-- Title -->
                <VBox alignment="CENTER" spacing="4">
                    <Label text="🌿 SERENITY" styleClass="login-title">
                        <font>
                            <Font name="System Bold" size="28.0"/>
                        </font>
                    </Label>
                    <Label text="Mental Health Therapy Center" styleClass="login-subtitle"/>
                </VBox>

                <Separator style="-fx-padding: 12 0;">
                    <VBox.margin>
                        <Insets top="12" bottom="12"/>
                    </VBox.margin>
                </Separator>

                <!-- Form Area -->
                <VBox spacing="12">
                    <Label text="Username" styleClass="field-label"/>
                    <TextField fx:id="txtUsername" prefHeight="42.0"
                               promptText="Enter your username" styleClass="text-input-light"/>

                    <Label text="Password" styleClass="field-label"/>

                    <!-- View Password Feature -->
                    <StackPane alignment="CENTER_LEFT">
                        <children>
                            <PasswordField fx:id="txtPassword" prefHeight="42.0"
                                           promptText="Enter your password" styleClass="text-input-light"/>
                            <TextField fx:id="txtPasswordPlain" prefHeight="42.0" visible="false"
                                       styleClass="text-input-light"/>
                        </children>
                    </StackPane>

                    <CheckBox fx:id="chkShowPassword" text="Show Password" onAction="#chkShowPasswordOnAction"
                              style="-fx-text-fill: #718096; -fx-font-size: 12px; -fx-cursor: hand;"/>

                    <Region prefHeight="10"/>

                    <Button fx:id="btnLogin" maxWidth="Infinity"
                            text="Sign In →"
                            styleClass="btn-mint"
                            prefHeight="46.0"
                            onAction="#btnLoginOnAction"/>

                    <Label fx:id="lblError" styleClass="error-label" maxWidth="Infinity"
                           alignment="CENTER" wrapText="true"/>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>